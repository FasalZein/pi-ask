{
  "name": "@fasalzein/pi-ask",
  "version": "1.4.0",
  "description": "Pi package that adds an interactive ask_user clarification tool.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FasalZein/pi-ask.git"
  },
  "homepage": "https://github.com/FasalZein/pi-ask#readme",
  "bugs": {
    "url": "https://github.com/FasalZein/pi-ask/issues"
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "ask_user",
    "clarification",
    "terminal-ui"
  ],
  "files": [
    "src/",
    "docs/configuration.md",
    "docs/contract.md",
    "docs/remote-events.md",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "dev": "sh -c 'ROOT=\"$PWD\"; TARGET=\"${1:-.}\"; if [ \"$TARGET\" = \"--\" ]; then TARGET=\"${2:-.}\"; fi; cd \"$TARGET\" && pi --no-extensions --no-skills --no-prompt-templates --no-themes --no-context-files -e \"$ROOT/src/index.ts\"' --",
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc -p tsconfig.json",
    "check:pi-floor": "bash scripts/check-pi-floor.sh",
    "format": "biome format --write .",
    "lint": "biome lint --write .",
    "check": "ultracite check",
    "check:ci": "biome ci .",
    "fix": "ultracite fix",
    "commit": "cz",
    "commitlint": "commitlint"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*",
    "@earendil-works/pi-ai": "*"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.12",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@earendil-works/pi-ai": "0.87.1",
    "@earendil-works/pi-coding-agent": "0.87.1",
    "@earendil-works/pi-tui": "0.87.1",
    "typebox": "1.3.27",
    "@types/node": "25.6.0",
    "commitizen": "^4.3.1",
    "cz-conventional-changelog": "^3.3.0",
    "lefthook": "^2.1.6",
    "typescript": "6.0.2",
    "ultracite": "7.6.0"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  }
}
